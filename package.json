{
  "name": "browser-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000 --open",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "serve": "node server.js",
    "build:server": "esbuild server.js --bundle --platform=node --target=node26 --format=cjs --outfile=dist/server.cjs",
    "package:windows": "npm run build && npm run build:server && node scripts/build-windows-sea.cjs && powershell.exe -NoProfile -NonInteractive -File scripts/compress-windows-exe.ps1 myapp.exe myapp.exe.zip"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "description": "",
  "dependencies": {
    "@octokit/auth-oauth-app": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve-handler": "^6.1.7",
    "styled-components": "^6.6.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "vite": "^8.3.4"
  },
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "^26.12.0"
  }
}
